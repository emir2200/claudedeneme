-- ─────────────────────────────────────────────────────────────────────────────
-- Lav dinozorunun iskeleti ve animasyon mantığı.
--
-- Bu dosya, build.luau'nun ürettiği veri tablosunun (Rig.bones, Rig.parts,
-- Rig.glowGroups, Rig.drips) ALTINA eklenir ve birlikte "DinozorRig"
-- ModuleScript'ini oluşturur. Yalnızca CFrame/Vector3/math kullanır; Roblox
-- servislerine dokunmaz, bu sayede aynı kod Lune ile bilgisayarda da test edilir.
--
-- Kemikler: her kemiğin dinlenme pivotu vardır; dinlenme yönelimi dünya eksenleriyle
-- aynıdır. Pozdaki dönüşler kemiğin kendi pivotu etrafında uygulanır:
--   X ekseni = başı kaldırma/indirme, Y = sağa sola çevirme, Z = yana yatırma.
-- Model -Z yönüne bakar (Roblox'un "ön" yönü).
-- ─────────────────────────────────────────────────────────────────────────────

local TAU = math.pi * 2
local A = CFrame.Angles

Rig.ROAR_DURATION = 4.0
Rig.ROAR_INTERVAL = 12
Rig.BREATH_PERIOD = 3.2

Rig.boneIndex = {}
for i, b in Rig.bones do
	Rig.boneIndex[b.name] = i
end

local function smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

--- Kükreme başlangıcından bu yana geçen süre `rt` için (hazırlık, kükreme) şiddetleri, 0..1.
--- 0.0–0.8 sn hazırlık (baş kalkar, ağız kapanır), 0.8–3.2 sn kükreme ve alev, 3.2–4.0 sn sakinleşme.
function Rig.roarEnvelope(rt: number?): (number, number)
	if rt == nil or rt < 0 or rt > Rig.ROAR_DURATION then
		return 0, 0
	end
	local windup = smooth(rt / 0.8) * (1 - smooth((rt - 0.8) / 0.35))
	local roar = smooth((rt - 0.8) / 0.35) * (1 - smooth((rt - 3.2) / 0.8))
	return windup, roar
end

--- Şu an kükreme sürüyorsa başlangıcından geçen süreyi, sürmüyorsa nil döner.
--- `now` sunucu saatidir; bu sayede bütün oyuncular kükremeyi aynı anda görür.
function Rig.roarTime(now: number, auto: boolean, interval: number, manualStart: number?): number?
	if manualStart then
		local rt = now - manualStart
		if rt >= 0 and rt <= Rig.ROAR_DURATION then
			return rt
		end
	end
	if auto and interval > Rig.ROAR_DURATION then
		local rt = (now + 4) % interval
		if rt <= Rig.ROAR_DURATION then
			return rt
		end
	end
	return nil
end

--- Zaman `t` ve kükreme süresi `rt` için kemik dönüşleri (kemik sırası → CFrame).
function Rig.pose(t: number, rt: number?): { [number]: CFrame }
	local windup, roar = Rig.roarEnvelope(rt)
	local calm = 1 - math.max(windup, roar)
	local breath = math.sin(t * TAU / Rig.BREATH_PERIOD)
	local p = {}
	local function set(name: string, cf: CFrame)
		local i = Rig.boneIndex[name]
		if i then
			p[i] = cf
		end
	end

	-- Gövde: nefes alıp verme; hazırlıkta göğsünü kaldırır, kükrerken öne atılır.
	set("spine1", A(0.015 * breath + 0.05 * windup - 0.035 * roar, 0.025 * math.sin(t * 0.33) * calm, 0))
	set("chest", A(0.012 * math.sin(t * TAU / Rig.BREATH_PERIOD + 0.5) + 0.05 * windup - 0.03 * roar, 0.03 * math.sin(t * 0.41 + 1) * calm, 0))

	-- Boyun ve baş: sakinken etrafı süzer; hazırlıkta başını kaldırır; kükrerken ileri uzatıp sallar.
	local look = math.sin(t * 0.29) * 0.22 + math.sin(t * 0.71) * 0.06
	local nod = math.sin(t * 0.53) * 0.035
	local shake = roar * 0.07 * math.sin(t * 8.5)
	for _, name in { "neck1", "neck2" } do
		set(name, A(calm * nod + windup * 0.16 - roar * 0.03, calm * look / 3 + shake, 0))
	end
	set("head", A(calm * (nod - 0.02) + windup * 0.14 - roar * 0.02, calm * look / 3 + shake, roar * 0.05 * math.sin(t * 6.5)))
	-- Çene: negatif X aşağı açar. Sakinken ağız aralıktır, içindeki lav görünür.
	local idleJaw = 0.14 + 0.06 * (breath + 1) / 2 + 0.05 * math.max(0, math.sin(t * 0.9)) ^ 8
	set("jaw", A(-(idleJaw * calm + roar * (0.74 + 0.05 * math.sin(t * 16)) + windup * 0.04), 0, 0))

	-- Kuyruk: uca doğru gecikmeli dalga; kükrerken kalkar ve kamçılanır.
	for i = 1, 7 do
		local wave = math.sin(t * 0.95 - i * 0.5)
		set("tail" .. i, A(0.012 * math.sin(t * 0.7 - i * 0.45) - 0.035 * roar + 0.02 * windup, (0.05 + 0.06 * roar) * wave + roar * 0.04 * math.sin(t * 5 - i * 0.8), 0))
	end

	-- Kısa ön kollar: seğirir; kükrerken öne kalkar, pençeler açılır.
	for side, sgn in { L = 1, R = -1 } do
		local twitch = math.sin(t * 1.2 + (if sgn > 0 then 0 else 2.1))
		set("arm" .. side, A(0.12 * twitch * calm + 0.4 * roar - 0.2 * windup, 0, sgn * 0.12 * roar))
		set("forearm" .. side, A(-0.15 * twitch * calm - 0.3 * roar, 0, 0))
		set("hand" .. side, A(0.2 * math.sin(t * 1.7 + sgn) * calm - 0.3 * roar, 0, 0))
	end
	return p
end

--- Pozdan, kemiklerin model uzayındaki CFrame'lerini hesaplar. `scale` Model:GetScale().
function Rig.solve(pose: { [number]: CFrame }, scale: number): { CFrame }
	local out = table.create(#Rig.bones)
	for i, b in Rig.bones do
		local cf = CFrame.new(b.rel * scale)
		local rot = pose[i]
		if rot then
			cf *= rot
		end
		out[i] = if b.parent > 0 then out[b.parent] * cf else cf
	end
	return out
end

--- Lav çatlaklarının parlaklığı, 0..1. `phase` parçanın göğüsten uzaklığına bağlı gecikmedir:
--- nabız ve kükremedeki parlama göğüsten başa, bacaklara ve kuyruk ucuna doğru dalga gibi yayılır.
function Rig.glow(t: number, rt: number?, phase: number): number
	local windup, roar = Rig.roarEnvelope(if rt then rt - phase * 0.5 else nil)
	local pulse = 0.5 + 0.5 * math.sin((t - phase) * TAU / Rig.BREATH_PERIOD)
	local flicker = 0.06 * math.sin(t * 5.3 + phase * 11) * math.sin(t * 3.1 + phase * 5)
	return math.clamp(0.28 + 0.34 * pulse + flicker + 0.4 * math.max(roar, windup * 0.5) + roar * 0.1 * math.sin(t * 19 + phase * 9), 0, 1)
end

--- Damlanın boy oranı (0..1) ve kaçıncı damla olduğu: uzar, uzar, kopar ve baştan başlar.
function Rig.dripCycle(t: number, period: number, phase: number): (number, number)
	local c = t / period + phase
	local n = math.floor(c)
	local f = c - n
	return 0.3 + 0.7 * f * f, n
end

return Rig
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="1074">
      <Properties>
        <string name="Name">Animasyon</string>
        <token name="RunContext">2</token>
        <string name="Source"><![CDATA[--[[
	Lav Dinozoru — animasyon (istemci)

	Bu Script'in RunContext'i "Client"tır: model Workspace'teyken her oyuncunun
	bilgisayarında çalışır, animasyonu orada akıcı biçimde oynatır. Roblox'a
	animasyon yüklemek gerekmez. Sunucu tarafında dinozor dinlenme pozunda kalır.

	Modelin öznitelikleri (Properties > Attributes) ile kontrol:
	  OtomatikKukreme (bool)   true ise belirli aralıklarla kendiliğinden kükrer.
	  KukremeAraligi  (number) otomatik kükremeler arasındaki saniye (varsayılan 12).
	  KukremeZamani   (number) bir sunucu script'inden kükretmek için:
	                           dinozor:SetAttribute("KukremeZamani", workspace:GetServerTimeNow())
	  AnimasyonHizi   (number) 1 = normal hız.

	Dinozoru taşımak için sunucuda dinozor:PivotTo(...) kullanın; animasyon "Kok"
	parçasını takip eder. Boyutu Studio'daki Scale aracıyla değiştirebilirsiniz.
]]

local RunService = game:GetService("RunService")

local model = script.Parent
local Rig = require(model:WaitForChild("DinozorRig"))
local root = model:WaitForChild("Kok") :: BasePart
local scale = model:GetScale()

local function findPart(name: string): BasePart?
	local deadline = os.clock() + 10
	local found = model:FindFirstChild(name, true)
	while not found and os.clock() < deadline do
		task.wait(0.2)
		found = model:FindFirstChild(name, true)
	end
	return found :: BasePart?
end

-- Kemiklere bağlı parçalar ve kemiğe göre konumları (ölçeğe uyarlanmış).
local parts: { BasePart } = {}
local bones: { number } = {}
local offsets: { CFrame } = {}
for _, def in Rig.parts do
	local part = findPart(def.name)
	if part then
		table.insert(parts, part)
		table.insert(bones, def.bone)
		table.insert(offsets, CFrame.new(def.offset.Position * scale) * def.offset.Rotation)
	end
end

-- Lav çatlakları: aynı nabız gecikmesindeki parçalar birlikte renk değiştirir.
local glowGroups = {}
for _, g in Rig.glowGroups do
	local list = {}
	for _, name in g.parts do
		local part = findPart(name)
		if part then
			table.insert(list, part)
		end
	end
	table.insert(glowGroups, { phase = g.phase, parts = list, value = -1, updated = 0 })
end

-- Damlayan lav: her karede asılı olduğu yerden aşağı sarkıtılır, koptuğunda bir damla düşer.
local drips = {}
for _, d in Rig.drips do
	local part = findPart(d.name)
	if part then
		local tip = part:FindFirstChild("DamlaUcu") :: Attachment?
		table.insert(drips, {
			part = part,
			tip = tip,
			emitter = tip and tip:FindFirstChildOfClass("ParticleEmitter"),
			bone = d.bone,
			anchor = d.anchor * scale,
			length = d.length * scale,
			width = d.width * scale,
			period = d.period,
			phase = d.phase,
			count = nil :: number?,
		})
	end
end

local breathEmitters: { ParticleEmitter } = {}
local backEmitters = {}
for _, d in model:GetDescendants() do
	if d:IsA("ParticleEmitter") then
		if d:GetAttribute("AlevNefesi") then
			table.insert(breathEmitters, d)
		elseif d:GetAttribute("SirtAlevi") then
			table.insert(backEmitters, { emitter = d, base = d:GetAttribute("TemelHiz") or d.Rate })
		end
	end
end
local mouthLight = model:FindFirstChild("AgizIsigi", true) :: PointLight?
local bellyLight = model:FindFirstChild("GovdeIsigi", true) :: PointLight?
local backLight = model:FindFirstChild("SirtIsigi", true) :: PointLight?

local GLOW_DIM = Color3.fromRGB(255, 70, 8)
local GLOW_BRIGHT = Color3.fromRGB(255, 190, 70)
local GLOW_STEP = 0.02 -- bundan küçük parlaklık değişimlerinde renkleri yeniden yazma
local GLOW_MIN_INTERVAL = 0.05
local FAR_DISTANCE = 700
local FAR_UPDATE_INTERVAL = 0.25

local cframes = table.create(#parts)
local sinceUpdate = math.huge
local fireOn = false
local backBoost = -1

RunService.RenderStepped:Connect(function(dt: number)
	if not root.Parent then
		return
	end
	local rootCF = root.CFrame

	-- Uzaktaki dinozoru daha seyrek güncelle.
	sinceUpdate += dt
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position - rootCF.Position).Magnitude > FAR_DISTANCE * scale then
		if sinceUpdate < FAR_UPDATE_INTERVAL then
			return
		end
	end
	sinceUpdate = 0

	local now = workspace:GetServerTimeNow()
	local rt = Rig.roarTime(
		now,
		model:GetAttribute("OtomatikKukreme") ~= false,
		model:GetAttribute("KukremeAraligi") or Rig.ROAR_INTERVAL,
		model:GetAttribute("KukremeZamani")
	)
	local t = now * (model:GetAttribute("AnimasyonHizi") or 1)

	local boneCFs = Rig.solve(Rig.pose(t, rt), scale)
	for i, part in parts do
		cframes[i] = rootCF * boneCFs[bones[i]] * offsets[i]
	end
	workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)

	local clock = os.clock()
	for _, g in glowGroups do
		local value = Rig.glow(t, rt, g.phase)
		if math.abs(value - g.value) >= GLOW_STEP and clock - g.updated >= GLOW_MIN_INTERVAL then
			g.value = value
			g.updated = clock
			local color = GLOW_DIM:Lerp(GLOW_BRIGHT, value)
			for _, part in g.parts do
				part.Color = color
			end
		end
	end

	local down = -rootCF.UpVector
	local rotation = rootCF.Rotation
	for _, d in drips do
		local top = rootCF * (boneCFs[d.bone] * d.anchor)
		local amount, count = Rig.dripCycle(t, d.period, d.phase)
		local len = d.length * amount
		d.part.Size = Vector3.new(d.width, len, d.width)
		d.part.CFrame = rotation + (top + down * (len * 0.45))
		if d.tip then
			d.tip.Position = Vector3.new(0, -len * 0.5, 0)
		end
		if count ~= d.count then
			if d.count and d.emitter then
				d.emitter:Emit(1)
			end
			d.count = count
		end
	end

	local windup, roar = Rig.roarEnvelope(rt)
	local wantFire = roar > 0.4
	if wantFire ~= fireOn then
		fireOn = wantFire
		for _, emitter in breathEmitters do
			emitter.Enabled = wantFire
		end
	end
	local boost = math.floor((1 + 2.5 * math.max(roar, windup * 0.5)) * 10 + 0.5) / 10
	if boost ~= backBoost then
		backBoost = boost
		for _, e in backEmitters do
			e.emitter.Rate = e.base * boost
		end
	end
	if mouthLight then
		mouthLight.Brightness = 1 + 6 * roar
	end
	if bellyLight then
		bellyLight.Brightness = 0.6 + 1.6 * Rig.glow(t, rt, 0)
	end
	if backLight then
		backLight.Brightness = 1.4 + 0.4 * math.sin(t * 11) * math.sin(t * 6.7) + 2.5 * roar
	end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
</roblox>