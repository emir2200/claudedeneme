# ───────────────────────── Çalışma modu ─────────────────────────
# demo : API anahtarı / veritabanı gerekmez. Panel, tohumlanmış simülasyon verisiyle
#        GERÇEK analitik hattını (index, matris, hype skorları) çalıştırır.
# live : Veriler PostgreSQL + Redis'ten okunur; worker (npm run worker) doldurur.
DATA_MODE=demo

# ───────────────────────── Altyapı ─────────────────────────
DATABASE_URL=postgresql://memecoin:memecoin@localhost:5432/memecoin?schema=public
# Boş bırakılırsa süreç içi bellek önbelleği kullanılır (tek süreç / geliştirme için).
REDIS_URL=redis://localhost:6379

# ───────────────────────── Veri sağlayıcıları ─────────────────────────
# DEXScreener ve GeckoTerminal'in herkese açık uçları anahtar istemez.
DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
DEFILLAMA_BASE_URL=https://api.llama.fi

# Sosyal metrikler (opsiyonel). Boşsa sosyal job atlanır.
LUNARCRUSH_API_KEY=

# Helius webhook'u (Solana balina swapları). Helius panelinde "Authorization header"
# alanına aynı değeri yazın. Boşsa webhook uç noktası 503 döner.
HELIUS_WEBHOOK_SECRET=

# EVM swap log taraması (BSC ve Robinhood Chain balina swapları). Boşsa atlanır.
BSC_RPC_URL=
ROBINHOOD_RPC_URL=

# ───────────────────────── Robinhood Chain kimlikleri ─────────────────────────
# Robinhood Chain (Arbitrum Orbit tabanlı L2) için sağlayıcı kimlikleri henüz
# doğrulanmadı. Sağlayıcının belgelerinden kontrol edip gerekirse değiştirin.
ROBINHOOD_CHAIN_ID=
ROBINHOOD_DEXSCREENER_ID=robinhood
ROBINHOOD_GECKO_NETWORK=robinhood
ROBINHOOD_DEFILLAMA_NAME=Robinhood
# Blok gezgini bağlantı önekleri (ör. https://explorer.example/tx/ ve https://explorer.example/token/).
# Boşsa bağlantı gösterilmez.
NEXT_PUBLIC_ROBINHOOD_EXPLORER_TX_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_TOKEN_URL=

# ───────────────────────── Eşikler ─────────────────────────
MILESTONE_USD=100000
WHALE_MIN_USD=10000
# Bir cüzdan bir saatte bu kadar swap yaparsa "bot" sayılır.
BOT_TX_PER_HOUR=30
