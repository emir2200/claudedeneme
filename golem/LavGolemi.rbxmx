    <Item class="ModuleScript" referent="702">
      <Properties>
        <string name="Name">GolemRig</string>
        <string name="Source"><![CDATA[-- Bu tablo build.luau tarafından üretildi; elle düzenlemeyin.
local Rig = {}

Rig.bones = {
	{ name = "kok", parent = 0, rel = Vector3.new(0, 5.4, 0.4) },
	{ name = "govde", parent = 1, rel = Vector3.new(0, 1.8, -0.1) },
	{ name = "bas", parent = 2, rel = Vector3.new(0, 4.8, -0.9) },
	{ name = "kolL", parent = 2, rel = Vector3.new(4.6, 3.7, -0.2) },
	{ name = "onkolL", parent = 4, rel = Vector3.new(0.7, -3.3, 0.4) },
	{ name = "yumrukL", parent = 5, rel = Vector3.new(0.2, -2.8, -0.9) },
	{ name = "kolR", parent = 2, rel = Vector3.new(-4.6, 3.7, -0.2) },
	{ name = "onkolR", parent = 7, rel = Vector3.new(-0.7, -3.3, 0.4) },
	{ name = "yumrukR", parent = 8, rel = Vector3.new(-0.2, -2.8, -0.9) },
}

Rig.parts = {
